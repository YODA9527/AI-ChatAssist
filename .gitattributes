# Git 属性: 控制 diff / 换行 / LFS / 语言识别

# 默认行尾: 全部 LF (Windows 用户提交前会被自动转换)
*               text=auto eol=lf

# 明确指定文本类型 (避免被误判为二进制)
*.kt            text eol=lf
*.kts           text eol=lf
*.java          text eol=lf
*.xml           text eol=lf
*.gradle        text eol=lf
*.toml          text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.md            text eol=lf
*.sh            text eol=lf
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# 二进制文件 (语言识别)
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.webm          binary
*.mp4           binary
*.pdf           binary
*.zip           binary
*.apk           binary
*.aab           binary
*.keystore      binary
*.jks           binary

# Git LFS 占位 (若启用,取消注释)
# *.psd          filter=lfs diff=lfs merge=lfs -text
# *.ai           filter=lfs diff=lfs merge=lfs -text

# Diff 设置: 关键字不高亮,降低噪音
*.md            diff=markdown
*.kt            diff=kotlin
