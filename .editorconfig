# EditorConfig: https://editorconfig.org
# ChatAssist 项目统一编辑器配置 — 所有 IDE / 编辑器自动读取

root = true

[*]
charset                  = utf-8
end_of_line              = lf
indent_style              = space
indent_size               = 4
insert_final_newline     = true
trim_trailing_whitespace = true
max_line_length           = 120

[*.{kt,kts}]
# Kotlin 官方风格 + Android 推荐
indent_size = 4
max_line_length = 120
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^

[*.{xml,html}]
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
# Markdown 不强制删尾空格 (可能影响换行)
trim_trailing_whitespace = false
max_line_length = unset

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
